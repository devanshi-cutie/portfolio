# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Leave Supabase/Cloudinary blank to run in local preview mode (content from src/creators, media from /data).
# In production a missing Supabase config is an error unless ALLOW_PREVIEW_CONTENT=1 (see the end of this file).

# --- Site ---------------------------------------------------------------
# Public URL, used for metadata, sitemap and OG images. No trailing slash.
# If empty: https://$VERCEL_PROJECT_PRODUCTION_URL, then https://$VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key. Safe in the browser; RLS protects writes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role / secret key. Server-only, never sent to the browser. Used by the
# admin panel (after the password check) and by the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Optional locally (needed as a GitHub Actions secret): Session pooler connection
# string, used only to apply SQL migrations. Supabase → Connect → Session pooler.
# Not the "Direct connection" (db.<ref>.supabase.co), which is IPv6-only.
SUPABASE_DB_URL=

# --- Cloudinary (Console → Settings → API Keys) ------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Same value as CLOUDINARY_API_KEY; the signed upload widget needs it in the browser (not a secret).
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder for this creator's assets in your Cloudinary media library (default: the active creator's id).
NEXT_PUBLIC_CLOUDINARY_FOLDER=devanshi

# --- Seed script (npm run seed) ----------------------------------------
# Files above these sizes are compressed with ffmpeg before upload.
# Cloudinary's free plan rejects videos over 100 MB and images over 10 MB.
SEED_MAX_VIDEO_MB=95
SEED_MAX_IMAGE_MB=9.5
# Path to the folder with the creator's media (default: ./data)
SEED_DATA_DIR=./data

# --- Admin panel -------------------------------------------------------
# The only way into /admin. Use a long random passphrase and set it in
# Vercel → Settings → Environment Variables. Changing it signs everyone out.
ADMIN_PASSWORD=
# Optional: separate secret for signing admin session cookies (32+ random chars).
# If empty, a key is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# --- Preview content ---------------------------------------------------
# Set to 1 to serve the bundled creator content when Supabase is not configured in
# production (demo deploys, or a local `next build` check without credentials).
# Leave empty for real deploys so a missing Supabase config fails loudly.
ALLOW_PREVIEW_CONTENT=
